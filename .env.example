# ---------------------------------------------------------------------------
# F1 Crazy — environment template
# Copy this file to .env and replace the placeholder values.
# Never commit a real .env file or real secrets to version control.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
# Port the Express API binds to (assigned by the deploy script).
PORT=4119

# Node environment: development | production
NODE_ENV=production

# --- TLS -------------------------------------------------------------------
# Set to 'true' to terminate TLS directly inside the API process.
# When 'false' the API starts a plain HTTP server (useful for local dev).
SSL_ENABLED=true

# Absolute path to the TLS certificate file.
SSL_CERT_PATH=/home/arx-app/backends/certs/certificate.crt

# Absolute path to the TLS private key file.
SSL_KEY_PATH=/home/arx-app/backends/certs/private.key

# Optional absolute path to a CA bundle file. Leave empty if not required.
SSL_CA_PATH=/home/arx-app/backends/certs/ca_bundle.crt

# --- Sessions --------------------------------------------------------------
# Secret used to sign the express-session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- Database (MySQL) ------------------------------------------------------
DB_HOST=localhost
DB_USER=f1crazy_user
DB_PASSWORD=replace-with-db-password
DB_NAME=f1crazy

# --- Frontend --------------------------------------------------------------
# Public base URL of the F1 Crazy API used by the browser.
# Must be reachable over HTTPS from the frontend origin for cookies to work.
NEXT_PUBLIC_API_BASE_URL=https://f1crazy-api.arx-app.com:4119